# API Configuration
PORT=3000
RABBITMQ_URL=amqp://guest:guest@localhost:5672
QUEUE_NAME=tasks
LOG_LEVEL=info

# Service endpoint configuration (required for service startup)
API_URL=http://localhost:3000
POLL_INTERVAL_MS=5000
TASK_DAEMON_STATUS_PORT=7070
TASK_DAEMON_DISABLE_MACHINE_LOCK=
TASK_DAEMON_STATUS_URL=http://127.0.0.1:7070

# Lark service credentials (required for lark-listener, task-enrichment, and lark-result)
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret
LARK_RECIPIENT_ID=your_lark_recipient_open_id

# Telegram Result Daemon Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
