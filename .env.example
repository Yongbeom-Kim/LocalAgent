# API Configuration
PORT=3000
RABBITMQ_URL=amqp://guest:guest@localhost:5672
QUEUE_NAME=tasks
LOG_LEVEL=info

# Service endpoint configuration (required for service startup)
API_URL=http://localhost:3000
POLL_INTERVAL_MS=5000
TASK_DAEMON_STATUS_PORT=7070
# Dev/test only: set to 1 to bypass the single-machine task-daemon lock.
TASK_DAEMON_DISABLE_MACHINE_LOCK=
TASK_DAEMON_STATUS_URL=http://127.0.0.1:7070
LOCAL_AGENT_DB_PATH=/tmp/local-agent.sqlite
LOCAL_AGENT_DB_EXPECTED_SCHEMA_VERSION=1

# Lark service credentials (required for lark-listener and lark-result)
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret
LARK_RECIPIENT_ID=your_lark_recipient_open_id

# Telegram Result Daemon Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
