{
  "rabbit_version": "3.13.0",
  "exchanges": [
    { "name": "tasks.exchange", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false },
    { "name": "jobs.exchange", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false },
    { "name": "results.exchange", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false }
  ],
  "queues": [
    { "name": "tasks.queue", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "jobs.queue", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "results.queue", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "tasks.exchange", "vhost": "/", "destination": "tasks.queue", "destination_type": "queue", "routing_key": "task.#", "arguments": {} },
    { "source": "jobs.exchange", "vhost": "/", "destination": "jobs.queue", "destination_type": "queue", "routing_key": "job.#", "arguments": {} },
    { "source": "results.exchange", "vhost": "/", "destination": "results.queue", "destination_type": "queue", "routing_key": "result.#", "arguments": {} }
  ]
}
